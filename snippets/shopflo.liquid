    </div>
  {% when 'buy_now' %}
    {%- liquid
      # Badge SVG defs (filter/gradient) below must have unique ids per render - see the same
      # comment in the 'checkout' case above. section.id alone isn't enough here since a
      # collection/carousel section could render multiple products' buy-now buttons at once, so
      # product_obj.id is folded in too.
      assign shopflo_badge_uid = section.id | append: '-buy-now-' | append: product_obj.id | default: 'buy-now'

      assign render_shopflo_buy_now_button = true
      if settings.shopflo_out_of_stock_buy_now == 'hide' and product_obj.selected_or_first_available_variant.available == false
        assign render_shopflo_buy_now_button = false
      endif

      assign disable_shopflo_buy_now_button = false
      if settings.shopflo_out_of_stock_buy_now == 'disable' and product_obj.selected_or_first_available_variant.available == false
        assign disable_shopflo_buy_now_button = true
      endif

      assign buy_now_full_width = settings.shopflo_full_width_buy_now
      assign buy_now_label_alignment = settings.shopflo_label_alignment_buy_now
      assign buy_now_font_weight = 'normal'
      if settings.shopflo_bold_text_buy_now
        assign buy_now_font_weight = 'bold'
      endif

      if settings.shopflo_match_checkout_layout_buy_now
        assign buy_now_full_width = settings.shopflo_full_width_checkout
        assign buy_now_label_alignment = settings.shopflo_label_alignment_checkout
        assign buy_now_font_weight = settings.shopflo_font_weight_checkout
      endif

      assign buy_now_shadow_style = settings.shopflo_shadow_style_buy_now
      if settings.shopflo_match_checkout_style_buy_now
        assign buy_now_shadow_style = settings.shopflo_shadow_style_checkout
      endif

      assign buy_now_hover_effect = settings.shopflo_hover_effect_buy_now
      if settings.shopflo_match_checkout_animation_buy_now
        assign buy_now_hover_effect = settings.shopflo_hover_effect_checkout
      endif

      assign buy_now_icons_enabled = settings.shopflo_payment_icons_buy_now
      assign buy_now_icon_position = settings.shopflo_payment_icon_position_buy_now
      assign buy_now_icon_1 = settings.shopflo_payment_icon_1_buy_now
      assign buy_now_icon_2 = settings.shopflo_payment_icon_2_buy_now
      assign buy_now_icon_3 = settings.shopflo_payment_icon_3_buy_now
      if settings.shopflo_match_checkout_icon_buy_now
        assign buy_now_icons_enabled = settings.shopflo_payment_icons_checkout
        assign buy_now_icon_position = settings.shopflo_payment_icon_position_checkout
        assign buy_now_icon_1 = settings.shopflo_payment_icon_checkout_1
        assign buy_now_icon_2 = settings.shopflo_payment_icon_checkout_2
        assign buy_now_icon_3 = settings.shopflo_payment_icon_checkout_3
      endif

      # shopflo_payment_icons (render param, see @doc above) is an extra AND-gate on top of
      # whichever "Show payment icons" setting buy_now_icons_enabled just resolved to (its own,
      # or checkout's when "Match Checkout" is on) - both still have to be true for the row to
      # render.
      if shopflo_payment_icons == false
        assign buy_now_icons_enabled = false
      endif

      assign buy_now_icons_list = buy_now_icon_1 | append: '|' | append: buy_now_icon_2 | append: '|' | append: buy_now_icon_3 | split: '|'

      assign any_selected_buy_now_payment_icons = false
      if buy_now_icon_1 != 'none' or buy_now_icon_2 != 'none' or buy_now_icon_3 != 'none'
        assign any_selected_buy_now_payment_icons = true
      endif

      assign buy_now_promo_text = settings.shopflo_promo_text_buy_now
      assign buy_now_promo_alignment = settings.shopflo_promo_text_alignment_buy_now
      assign buy_now_promo_banner_layout = settings.shopflo_promo_banner_layout_buy_now
      assign buy_now_promo_position = settings.shopflo_promo_position_buy_now
      if settings.shopflo_match_checkout_promo_buy_now
        assign buy_now_promo_text = settings.shopflo_promo_text_checkout
        assign buy_now_promo_alignment = settings.shopflo_promo_text_alignment_checkout
        assign buy_now_promo_banner_layout = settings.shopflo_promo_banner_layout_checkout
        assign buy_now_promo_position = settings.shopflo_promo_position_checkout
      endif

      # richtext setting - a merchant-cleared field can still come back as e.g. "<p></p>" or
      # "<p>&nbsp;</p>" (non-blank as raw HTML), so strip tags/nbsp before checking presence -
      # same treatment as shopflo_promo_text_checkout_present above.
      assign shopflo_promo_text_check_buy_now = buy_now_promo_text | strip_html | remove: '&nbsp;' | strip
      assign shopflo_promo_text_buy_now_present = false
      unless shopflo_promo_text_check_buy_now == blank
        assign shopflo_promo_text_buy_now_present = true
      endunless
    -%}

    {% capture buy_now_wrapper_class %} shopflo-buy-now__wrapper {% if buy_now_full_width == true %} sf-full-width {% endif %} {% if shopflo_promo_text_buy_now_present %} sf-promo-banner__layout--{{ buy_now_promo_banner_layout }} {% endif %}{% endcapture %}

    {% capture buy_now_button_class %}
    shopflo-buy-now__button shopflo-popup-trigger {% if buy_now_full_width == true %} sf-full-width {% endif %} {% if buy_now_shadow_style != 'none' %} sf-button-shadow--{{ buy_now_shadow_style }} {%
    endif %} {% if buy_now_hover_effect != 'none' %} sf-button-hover--{{ buy_now_hover_effect }} {% endif %} {% if buy_now_icons_enabled == true %} sf-buy-now-payment-icon--{{ buy_now_icon_position }} {% endif %}
